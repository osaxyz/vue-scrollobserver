{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "vue-scrollobserver-demo",
    // The account is given by CLOUDFLARE_ACCOUNT_ID in apps/demo/.env, which is not committed.
    "compatibility_date": "2026-10-08",
    // The demo is a static Vite build, so the Worker has no script and only serves assets.
    "assets": {
        "directory": "./dist"
    }
}
